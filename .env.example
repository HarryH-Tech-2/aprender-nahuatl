# Accounts are optional. Leave these empty and the site works with progress saved in the browser only.
# When Supabase is added from the Vercel Marketplace, Vercel fills these in for you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 to show sign-in and synced progress (needs Google sign-in set up in Supabase first).
NEXT_PUBLIC_ACCOUNTS_ENABLED=
# Server only. Needed for the course waitlist and for "Borrar mi cuenta". Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Tag Manager container. Defaults to GTM-WQ6ZGHMT (set in src/lib/analytics.ts); GA4 is configured inside it.
NEXT_PUBLIC_GTM_ID=
# Only if you drop Tag Manager: a GA4 measurement ID (G-XXXXXXXXXX) to load directly.
NEXT_PUBLIC_GA_ID=
# Analytics runs only on the Vercel production deployment. Set to 1 to test it locally or on a preview.
NEXT_PUBLIC_ANALYTICS_FORCE=
# Search Console HTML-tag verification code (only the content="..." value). Not needed with DNS verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Stripe (paid course). All server only except the last flag.
# Secret API key (sk_...). Never expose it to the browser.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint https://<site>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Price id (price_...) of the monthly subscription.
STRIPE_PRICE_MONTHLY=
# Price id (price_...) of the one-time lifetime payment.
STRIPE_PRICE_LIFETIME=
# Set to 1 once the four Stripe values are in Vercel.
NEXT_PUBLIC_CHECKOUT_ENABLED=
